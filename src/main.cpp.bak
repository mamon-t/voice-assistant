// src/main.cpp
#include <QApplication>
#include <QDBusConnection>
#include <QDir>
#include <QStandardPaths>
#include <QDebug>

#include "core/Application.h"
#include "core/ApplicationController.h"
#include "audio/QtAudioCapture.h"
#include "vad/SileroVad.h"
#include "asr/SenseVoiceRecognizer.h"
#include "commands/CommandParser.h"
#include "output/XdotoolInjector.h"
#include "spellcheck/AspellChecker.h"
#include "config/ConfigManager.h"
#include "onnx/OnnxEnvironment.h"
#include "dbus/DBusInterface.h"
#include "ui/TrayIcon.h"

int main(int argc, char *argv[]) {
    QApplication app(argc, argv);
    app.setApplicationName("voice-assistant");
    app.setApplicationVersion("0.1.0");
    app.setOrganizationName("VoiceAssistant");
    
    // 1. Инициализация конфигурации
    ConfigManager config;
    
    // Создаем директории для конфигов, если их нет
    QString configDir = QStandardPaths::writableLocation(QStandardPaths::ConfigLocation) 
                        + "/voice-assistant";
    QDir().mkpath(configDir);
    
    // Копируем дефолтные конфиги, если их нет
    QString defaultSettings = configDir + "/settings.ini";
    if (!QFile::exists(defaultSettings)) {
        QFile::copy(":/config/settings.ini", defaultSettings);
    }
    
    QString defaultCommandsHotwords = configDir + "/commands_hotwords.txt";
    if (!QFile::exists(defaultCommandsHotwords)) {
        QFile::copy(":/config/commands_hotwords.txt", defaultCommandsHotwords);
    }
    
    QString defaultUserHotwords = configDir + "/user_hotwords.txt";
    if (!QFile::exists(defaultUserHotwords)) {
        QFile::copy(":/config/user_hotwords.txt", defaultUserHotwords);
    }
    
    // 2. Инициализация ONNX Runtime (singleton)
    OnnxEnvironment& onnxEnv = OnnxEnvironment::instance();
    if (!onnxEnv.isInitialized()) {
        qCritical() << "Failed to initialize ONNX Runtime";
        return 1;
    }
    
    // 3. Проверка наличия моделей
    if (!QFile::exists(config.senseVoiceModelPath())) {
        qCritical() << "SenseVoice model not found at:" << config.senseVoiceModelPath();
        qCritical() << "Please run scripts/download_models.sh";
        return 1;
    }
    
    if (!QFile::exists(config.sileroVadPath())) {
        qCritical() << "Silero VAD model not found at:" << config.sileroVadPath();
        return 1;
    }
    
    // 4. Создание компонентов
    // Audio capture
    auto audioCapture = std::make_unique<QtAudioCapture>();
    if (!audioCapture->initialize()) {
        qCritical() << "Failed to initialize audio capture";
        return 1;
    }
    
    // VAD
    auto vad = std::make_unique<SileroVad>(config.sileroVadPath());
    if (!vad->initialize()) {
        qCritical() << "Failed to initialize VAD";
        return 1;
    }
    
    // ASR
    auto recognizer = std::make_unique<SenseVoiceRecognizer>(
        config.senseVoiceModelPath(),
        config.senseVoiceTokensPath(),
        2  // num_threads для Celeron
    );
    if (!recognizer->initialize()) {
        qCritical() << "Failed to initialize ASR recognizer";
        return 1;
    }
    
    // Загружаем hotwords
    QStringList commandsHotwords = config.loadHotwords(defaultCommandsHotwords);
    QStringList userHotwords = config.loadHotwords(defaultUserHotwords);
    QStringList allHotwords = commandsHotwords + userHotwords;
    
    if (!allHotwords.isEmpty()) {
        recognizer->setHotwords(allHotwords, 2.0f);  // hotwords_score = 2.0
    }
    
    // Command parser
    auto commandParser = std::make_unique<CommandParser>();
    
    // Text injector (xdotool)
    auto textInjector = std::make_unique<XdotoolInjector>();
    if (!textInjector->isAvailable()) {
        qWarning() << "xdotool not available, text output will be disabled";
        // Не критично, продолжаем
    }
    
    // Spell checker
    auto spellChecker = std::make_unique<AspellChecker>();
    if (!spellChecker->initialize()) {
        qWarning() << "aspell not available, spellcheck will be disabled";
        // Не критично, продолжаем
    }
    
    // 5. Создание контроллера приложения
    ApplicationController controller(
        audioCapture.get(),
        vad.get(),
        recognizer.get(),
        commandParser.get(),
        textInjector.get(),
        spellChecker.get()
    );
    
    // 6. Создание UI
    TrayIcon trayIcon(&controller);
    trayIcon.show();
    
    // 7. Регистрация DBus интерфейса
    QDBusConnection dbus = QDBusConnection::sessionBus();
    
    if (!dbus.registerService("org.voiceassistant.App")) {
        qWarning() << "Failed to register DBus service:" << dbus.lastError().message();
        // Не критично, продолжаем без DBus
    } else {
        auto* dbusAdapter = new DBusInterface(&controller);
        if (!dbus.registerObject("/org/voiceassistant/App", &controller)) {
            qWarning() << "Failed to register DBus object:" << dbus.lastError().message();
            delete dbusAdapter;
        } else {
            qDebug() << "DBus service registered: org.voiceassistant.App";
        }
    }
    
    // 8. Подключение сигналов для уведомлений
    QObject::connect(&controller, &ApplicationController::errorOccurred,
                     [&trayIcon](const QString& message) {
        trayIcon.showMessage("Voice Assistant", message, QSystemTrayIcon::Warning, 3000);
    });
    
    QObject::connect(&controller, &ApplicationController::modeChanged,
                     [&trayIcon](Mode mode) {
        QString modeStr;
        switch (mode) {
            case Mode::Off: modeStr = "Выключен"; break;
            case Mode::Dictation: modeStr = "Диктовка"; break;
            case Mode::Edit: modeStr = "Редактирование"; break;
            case Mode::Spellcheck: modeStr = "Проверка орфографии"; break;
        }
        trayIcon.showMessage("Voice Assistant", 
                            "Режим: " + modeStr, 
                            QSystemTrayIcon::Information, 
                            2000);
    });
    
    // 9. Запуск приложения
    qDebug() << "Voice Assistant started";
    qDebug() << "DBus: org.voiceassistant.App";
    qDebug() << "Models:" << config.modelsPath();
    
    int result = app.exec();
    
    // 10. Очистка
    dbus.unregisterService("org.voiceassistant.App");
    qDebug() << "Voice Assistant stopped";
    
    return result;
}