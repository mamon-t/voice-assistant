<!-- dbus/org.voiceassistant.App.xml -->
<!DOCTYPE node PUBLIC "-//freedesktop//DTD D-BUS Object Introspection 1.0//EN"
 "http://www.freedesktop.org/standards/dbus/1.0/introspect.dtd">
<node>
  <interface name="org.voiceassistant.App">
    <!-- Методы -->
    <method name="startRecording"/>
    <method name="stopRecording"/>
    <method name="setMode">
      <arg name="mode" type="s" direction="in"/>  <!-- "dictation", "edit", "spellcheck", "off" -->
    </method>
    <method name="getMode">
      <arg name="mode" type="s" direction="out"/>
    </method>
    <method name="reloadHotwords"/>
    <method name="startMicCheck">
      <arg name="path" type="s" direction="out"/>  <!-- "" если не started -->
    </method>
    <method name="stopMicCheck"/>
    <method name="isMicChecking">
      <arg name="recording" type="b" direction="out"/>
    </method>
    <method name="hotkeyStatus">
      <arg name="status" type="s" direction="out"/>
    </method>
    <!-- Куда писать распознанный текст: "focus" (активное окно) или "notes"
         (файл заметок). Заметки не трогают ни фокус, ни клавиатуру, ни буфер
         обмена, поэтому их можно диктовать, продолжая печатать руками. -->
    <method name="setOutputTarget">
      <arg name="target" type="s" direction="in"/>   <!-- "focus" | "notes" -->
    </method>
    <method name="getOutputTarget">
      <arg name="target" type="s" direction="out"/>
    </method>
    <method name="toggleOutputTarget"/>
    <method name="notesFile">
      <arg name="path" type="s" direction="out"/>    <!-- "" если заметки выключены -->
    </method>
    
    <!-- Сигналы -->
    <signal name="modeChanged">
      <arg name="mode" type="s"/>
    </signal>
    <signal name="textRecognized">
      <arg name="text" type="s"/>
    </signal>
    <signal name="errorOccurred">
      <arg name="message" type="s"/>
    </signal>
    <signal name="outputTargetChanged">
      <arg name="target" type="s"/>                  <!-- "focus" | "notes" -->
    </signal>
    <signal name="noteWritten">
      <arg name="path" type="s"/>
      <arg name="text" type="s"/>
    </signal>
  </interface>
</node>