root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{cpp,h,c,hpp,cc,cxx}]
indent_style = space
indent_size = 4

[*.{md,yml,yaml,xml,desktop,metainfo.xml}]
indent_style = space
indent_size = 2

[CMakeLists.txt]
indent_style = space
indent_size = 4

[Makefile]
indent_style = tab
